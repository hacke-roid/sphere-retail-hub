PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174
MONGODB_URI=mongodb://fastapi:fastapi_password@localhost:27017/fastapi?authSource=admin
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password

CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_FOLDER=replace_with_cloudinary_folder
